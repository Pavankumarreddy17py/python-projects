import tkinter as tk
from tkinter import messagebox
import requests
# You need to install this library: pip install lyricsgenius
import lyricsgenius as lg 

# ======================================================================
# 🛑 ACTION REQUIRED: REPLACE THIS PLACEHOLDER WITH YOUR GENIUS API TOKEN
# ======================================================================
# Get this token from the Genius API Client management page.
GENIUS_API_TOKEN = "YOUR_GENIUS_API_TOKEN_HERE" 
# ======================================================================


def fetch_lyrics():
    song_title = song_entry.get().strip()
    artist_name = artist_entry.get().strip()

    if not song_title or not artist_name:
        messagebox.showerror("Error", "Please enter both song title and artist name.")
        return
    
    # 1. Initialize Genius with the token
    if GENIUS_API_TOKEN == "YOUR_GENIUS_API_TOKEN_HERE":
        messagebox.showerror("Configuration Error", "Please replace 'YOUR_GENIUS_API_TOKEN_HERE' with your actual Genius Client Access Token.")
        return

    try:
        # Initializing the Genius client.
        # remove_section_headers=True cleans up [Chorus], [Verse 1] tags.
        genius = lg.Genius(GENIUS_API_TOKEN, 
                           remove_section_headers=True,
                           skip_non_songs=True,
                           verbose=False) # Set verbose=True for debugging search results
    except Exception as e:
        messagebox.showerror("Configuration Error", f"Could not initialize Genius API. Check your token: {str(e)}")
        return
        
    # Clear previous lyrics
    lyrics_text.config(state="normal")
    lyrics_text.delete('1.0', tk.END)
    lyrics_text.config(state="disabled")

    # 2. Search for the song
    try:
        # Search by song title and artist for high accuracy
        song = genius.search_song(song_title, artist_name) 

        if song:
            lyrics = song.lyrics
            lyrics_text.config(state="normal")
            lyrics_text.delete('1.0', tk.END)
            
            # Display song information and lyrics
            lyrics_text.insert(tk.END, f"--- Lyrics found via Genius for: {song.title} by {song.artist} ---\n\n")
            lyrics_text.insert(tk.END, lyrics)
            lyrics_text.config(state="disabled")
        else:
            messagebox.showerror("Lyrics Not Found", 
                                 f"Lyrics not found on Genius for: {song_title} by {artist_name}.")
            
    except Exception as e:
        # Catch network or unexpected errors during the search
        messagebox.showerror("API Error", f"An unexpected error occurred while searching: {str(e)}")


# Create the main window (GUI setup remains the same)
root = tk.Tk()
root.title("Song Lyrics Extractor")
root.configure(bg="black")

# Create labels and entry fields
song_label = tk.Label(root, text="Song Title:", bg="black", fg="white")
song_label.grid(row=0, column=0, padx=10, pady=5, sticky="e")
song_entry = tk.Entry(root)
song_entry.grid(row=0, column=1, padx=10, pady=5)

artist_label = tk.Label(root, text="Artist Name:", bg="black", fg="white")
artist_label.grid(row=1, column=0, padx=10, pady=5, sticky="e")
artist_entry = tk.Entry(root)
artist_entry.grid(row=1, column=1, padx=10, pady=5)

# Create a button to fetch lyrics
fetch_button = tk.Button(root, text="Fetch Lyrics", command=fetch_lyrics)
fetch_button.grid(row=2, column=0, columnspan=2, padx=10, pady=10)

# Create a text widget to display lyrics
lyrics_text = tk.Text(root, height=20, width=60, bg="black", fg="white")
lyrics_text.grid(row=3, column=0, columnspan=2, padx=10, pady=5)
lyrics_text.config(state="disabled")

# Center the window
window_width = 400
window_height = 450
screen_width = root.winfo_screenwidth()
screen_height = root.winfo_screenheight()
x_coordinate = int((screen_width / 2) - (window_width / 2))
y_coordinate = int((screen_height / 2) - (window_height / 2))
root.geometry(f"{window_width}x{window_height}+{x_coordinate}+{y_coordinate}")

# Start the GUI event loop
root.mainloop()
